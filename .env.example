# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (never commit real values).

# --- Added for you when you connect the Neon database in Vercel → Storage ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Added for you when you connect a Vercel Blob store (product photos) ---
BLOB_READ_WRITE_TOKEN=

# --- You add these ---
# Signs the admin login cookie. Any random string of 32+ characters,
# e.g. the output of: openssl rand -base64 32
AUTH_SECRET=

# The first admin account. Used once, on the very first sign-in at /admin.
# After that you can change the password in Admin → Settings and delete these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack → Settings → API Keys & Webhooks. Start with the test key (sk_test_…),
# switch to the live key (sk_live_…) when you're ready to take real payments.
PAYSTACK_SECRET_KEY=

# Optional. Paystack's newer webhook signing secret (whsec_…), if your dashboard shows one.
PAYSTACK_WEBHOOK_SECRET=

# Optional. Your shop's address, e.g. https://deniks20stitches.com
# (used in links and the sitemap; Vercel's domain is used when empty).
SITE_URL=

# Optional: order emails through Resend (resend.com). Without these the shop
# still works; Paystack sends its own payment receipt.
RESEND_API_KEY=
# e.g. Deniks20 Stitches <orders@your-domain.com> (a domain verified in Resend)
EMAIL_FROM=
# Where new-order alerts go (defaults to the contact email in Admin → Settings)
ORDER_ALERT_EMAIL=

# Local only: keep uploaded photos on disk instead of Vercel Blob.
# LOCAL_UPLOADS=1
